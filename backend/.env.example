# CORS Configuration
# CORS_ORIGIN should be set to comma-separated list of allowed origins
# Example for local development: http://localhost:3000
# Example for production: https://app.example.com,https://www.example.com
# WARNING: Do not use wildcard '*' in production - it bypasses CORS protection
# If CORS_ORIGIN is not set, all cross-origin requests will be rejected (fail-closed)
CORS_ORIGIN=http://localhost:3000

# Server port (default: 4000)
PORT=4000
